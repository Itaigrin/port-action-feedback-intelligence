# Port Action Feedback Intelligence — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# NOTE: The Streamlit app runs WITHOUT any of these set. It reads committed
# results from data/processed/. A key is only needed to RE-RUN the analysis
# pipeline against the live API.

# --- Required only to re-run the AI analysis pipeline ----------------------
# Get one at https://console.anthropic.com/ — starts with "sk-ant-"
ANTHROPIC_API_KEY=

# --- Optional overrides (sensible defaults are in src/utils/config.py) -----

# Model used for classification. Never hardcoded in source — read from here.
# Default: claude-sonnet-5 (cost-effective, reliable on relevance judgment).
# claude-haiku-4-5 is the cheapest alternative if you want to trade some accuracy.
# ANTHROPIC_MODEL=claude-sonnet-5

# Reasoning depth / token spend: low | medium | high | xhigh | max
# Default: medium — enough for a constrained classification schema.
# ANTHROPIC_EFFORT=medium

# Prompt version recorded on every analysed record for provenance.
# Bump this whenever the classification prompt changes.
# PROMPT_VERSION=v1.0

# Seconds to wait between HTTP requests during collection (politeness delay).
# Default: 2.0 — do not lower.
# COLLECTOR_DELAY_SECONDS=2.0
